<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="44dp">

    <TextView
        android:id="@+id/lblTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:gravity="center"
        android:text="Thêm người dùng"
        android:textColor="#040404"
        android:textSize="44sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/lblUN"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:text="Username:"
        android:textColor="#000000"
        android:textSize="26sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/txtUN"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/txtUN"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_input"
        android:inputType="text"
        android:padding="15dp"
        android:textSize="26sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/lblUN"
        app:layout_constraintTop_toBottomOf="@+id/lblTitle" />

    <TextView
        android:id="@+id/lblPW"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:text="Password:"
        android:textColor="#000000"
        android:textSize="26sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/txtPW"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/txtPW"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_input"
        android:inputType="textPassword"
        android:padding="15dp"
        android:textSize="26sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/lblPW"
        app:layout_constraintTop_toBottomOf="@+id/txtUN" />

    <TextView
        android:id="@+id/lblName"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:text="Fullname:"
        android:textColor="#000000"
        android:textSize="26sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/txtName"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/txtName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_input"
        android:inputType="textPersonName"
        android:padding="15dp"
        android:textSize="26sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/lblName"
        app:layout_constraintTop_toBottomOf="@+id/txtPW" />

    <TextView
        android:id="@+id/lblDob"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:text="DoB:"
        android:textColor="#000000"
        android:textSize="26sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/txtDob"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Không gõ tay được: bấm vào sẽ mở DatePickerDialog -->
    <EditText
        android:id="@+id/txtDob"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_input"
        android:clickable="true"
        android:drawableEnd="@drawable/ic_dropdown"
        android:focusable="false"
        android:hint="dd/mm/yyyy"
        android:inputType="none"
        android:padding="15dp"
        android:textSize="26sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/lblDob"
        app:layout_constraintTop_toBottomOf="@+id/txtName" />

    <Button
        android:id="@+id/btnAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:background="@android:color/transparent"
        android:text="Thêm"
        android:textColor="#000000"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/btnCancel"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtDob" />

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="34dp"
        android:background="@android:color/transparent"
        android:text="Hủy"
        android:textColor="#000000"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@+id/btnAdd"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btnAdd" />

</androidx.constraintlayout.widget.ConstraintLayout>
