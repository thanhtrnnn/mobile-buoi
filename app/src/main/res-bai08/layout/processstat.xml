<?xml version="1.0" encoding="utf-8"?>
<!-- Thống kê bài 08: giao diện dùng chung màu sắc và biểu tượng của bài 07. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/home_padding_horizontal" android:background="@color/screen_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageButton android:id="@+id/btnBackStat" android:layout_width="@dimen/stat_control_height" android:layout_height="@dimen/stat_control_height" android:background="@android:color/transparent" android:src="@drawable/ic_back" android:contentDescription="Quay lại" />
        <TextView android:id="@+id/lblStatTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="@dimen/stat_title_text" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● Thu     ● Chi" android:textSize="@dimen/stat_body_text" android:padding="8dp" android:gravity="center" android:id="@+id/lblLegend" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="horizontal">
        <ptit.cnpm1.tranxuanthanh.bai08.ProcessChartView android:id="@+id/processChart" android:layout_width="@dimen/stat_chart_width" android:layout_height="match_parent" />
    </HorizontalScrollView>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Vuốt ngang để xem đủ 12 tháng. Chạm một tháng để xem tỉ lệ." android:paddingTop="12dp" android:textSize="@dimen/stat_body_text" android:gravity="center" />
</LinearLayout>
