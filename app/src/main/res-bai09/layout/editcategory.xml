<?xml version="1.0" encoding="utf-8"?>
<!-- Giao diện Sửa mục thu/chi theo wireframe slide 8 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:padding="@dimen/form_root_padding">

    <TextView
        android:id="@+id/lblTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/form_title_top_margin"
        android:gravity="center"
        android:text="Sửa mục thu/chi"
        android:textColor="#040404"
        android:textSize="@dimen/form_title_text"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/lblType"
        android:layout_width="@dimen/form_category_label_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/form_type_top_margin"
        android:text="Kiểu GD:"
        android:textColor="#000000"
        android:textSize="@dimen/form_body_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblTitle" />

    <!-- Nút on/off: gạt sang trái là Chi, sang phải là Thu -->
    <TextView
        android:id="@+id/lblChi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/form_label_start_gap"
        android:text="Chi"
        android:textColor="@color/chi"
        android:textSize="@dimen/form_body_text"
        app:layout_constraintBaseline_toBaselineOf="@+id/lblType"
        app:layout_constraintStart_toEndOf="@+id/lblType" />

    <Switch
        android:id="@+id/swType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/form_switch_side_gap"
        android:scaleX="1.5"
        android:scaleY="1.5"
        app:layout_constraintBottom_toBottomOf="@+id/lblType"
        app:layout_constraintStart_toEndOf="@+id/lblChi"
        app:layout_constraintTop_toTopOf="@+id/lblType" />

    <TextView
        android:id="@+id/lblThu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/form_switch_side_gap"
        android:text="Thu"
        android:textColor="@color/thu"
        android:textSize="@dimen/form_body_text"
        app:layout_constraintBaseline_toBaselineOf="@+id/lblType"
        app:layout_constraintStart_toEndOf="@+id/swType" />

    <TextView
        android:id="@+id/lblParent"
        android:layout_width="@dimen/form_category_label_width"
        android:layout_height="wrap_content"
        android:text="Mục thu/chi cha:"
        android:textColor="#000000"
        android:textSize="@dimen/form_body_text"
        app:layout_constraintBottom_toBottomOf="@+id/spParent"
        app:layout_constraintTop_toTopOf="@+id/spParent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Để trống mục cha nghĩa là thêm mục cha ngang hàng các mục cha đã có -->
    <Spinner
        android:id="@+id/spParent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/form_label_start_gap"
        android:layout_marginTop="@dimen/form_field_top_gap"
        android:background="@drawable/bg_spinner"
        android:paddingEnd="@dimen/form_spinner_end_padding"
        app:layout_constraintEnd_toStartOf="@+id/btnNewParent"
        app:layout_constraintStart_toEndOf="@+id/lblParent"
        app:layout_constraintTop_toBottomOf="@+id/lblType" />

    <Button
        android:id="@+id/btnNewParent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:minWidth="@dimen/form_new_parent_min_width"
        android:text="+"
        android:textColor="#000000"
        android:textSize="@dimen/form_new_parent_text"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/spParent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/spParent" />

    <TextView
        android:id="@+id/lblName"
        android:layout_width="@dimen/form_category_label_width"
        android:layout_height="wrap_content"
        android:text="Tên mục thu/chi:"
        android:textColor="#000000"
        android:textSize="@dimen/form_body_text"
        app:layout_constraintBaseline_toBaselineOf="@+id/txtName"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/txtName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/form_label_start_gap"
        android:layout_marginTop="@dimen/form_field_top_gap"
        android:background="@drawable/bg_input"
        android:inputType="text"
        android:padding="@dimen/form_input_padding"
        android:textSize="@dimen/form_body_text"
        app:layout_constraintEnd_toStartOf="@+id/btnNewParent"
        app:layout_constraintStart_toEndOf="@+id/lblName"
        app:layout_constraintTop_toBottomOf="@+id/spParent" />

    <TextView
        android:id="@+id/lblNote"
        android:layout_width="@dimen/form_category_label_width"
        android:layout_height="wrap_content"
        android:text="Ghi chú:"
        android:textColor="#000000"
        android:textSize="@dimen/form_body_text"
        app:layout_constraintBaseline_toBaselineOf="@+id/txtNote"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/txtNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/form_label_start_gap"
        android:layout_marginTop="@dimen/form_field_top_gap"
        android:background="@drawable/bg_input"
        android:inputType="text"
        android:padding="@dimen/form_input_padding"
        android:textSize="@dimen/form_body_text"
        app:layout_constraintEnd_toStartOf="@+id/btnNewParent"
        app:layout_constraintStart_toEndOf="@+id/lblNote"
        app:layout_constraintTop_toBottomOf="@+id/txtName" />

    <TextView
        android:id="@+id/lblIcon"
        android:layout_width="@dimen/form_category_label_width"
        android:layout_height="wrap_content"
        android:text="Logo:"
        android:textColor="#000000"
        android:textSize="@dimen/form_body_text"
        app:layout_constraintBottom_toBottomOf="@+id/spIcon"
        app:layout_constraintTop_toTopOf="@+id/spIcon"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spIcon"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/form_label_start_gap"
        android:layout_marginTop="@dimen/form_field_top_gap"
        android:background="@drawable/bg_spinner"
        android:paddingEnd="@dimen/form_spinner_end_padding"
        app:layout_constraintEnd_toStartOf="@+id/btnNewParent"
        app:layout_constraintStart_toEndOf="@+id/lblIcon"
        app:layout_constraintTop_toBottomOf="@+id/txtNote" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/form_action_top_margin"
        android:background="@android:color/transparent"
        android:text="Lưu"
        android:textColor="#000000"
        android:textSize="@dimen/form_action_text"
        android:textStyle="bold"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintEnd_toStartOf="@+id/btnDelete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spIcon" />

    <Button
        android:id="@+id/btnDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:text="Xóa"
        android:textColor="#000000"
        android:textSize="@dimen/form_action_text"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/btnSave"
        app:layout_constraintEnd_toStartOf="@+id/btnCancel"
        app:layout_constraintBaseline_toBaselineOf="@+id/btnSave" />

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:text="Hủy"
        android:textColor="#000000"
        android:textSize="@dimen/form_action_text"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/btnDelete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@+id/btnSave" />

</androidx.constraintlayout.widget.ConstraintLayout>
