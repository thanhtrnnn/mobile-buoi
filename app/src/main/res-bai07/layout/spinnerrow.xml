<?xml version="1.0" encoding="utf-8"?>
<!-- Một dòng trong Spinner mục thu/chi và Spinner logo: logo + chữ, giống
     danh sách mục có logo ở wireframe slide 7 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spinner_row_padding_horizontal"
    android:paddingTop="@dimen/spinner_row_padding_vertical"
    android:paddingEnd="@dimen/spinner_row_padding_horizontal"
    android:paddingBottom="@dimen/spinner_row_padding_vertical">

    <ImageView
        android:id="@+id/imgIcon"
        android:layout_width="@dimen/spinner_icon_size"
        android:layout_height="@dimen/spinner_icon_size"
        android:background="@drawable/bg_list_item"
        android:padding="@dimen/spinner_icon_padding" />

    <TextView
        android:id="@+id/lblName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spinner_text_margin_start"
        android:textColor="#000000"
        android:textSize="@dimen/spinner_text_size" />

</LinearLayout>
